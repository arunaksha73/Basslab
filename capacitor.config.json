{
  "appId": "com.basslab.threed",
  "appName": "BassLab 3D",
  "webDir": "www",
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 2000,
      "launchAutoHide": true,
      "backgroundColor": "#12121a",
      "androidSplashResourceName": "splash",
      "androidScaleType": "CENTER_CROP",
      "showSpinner": false
    },
    "StatusBar": {
      "style": "DARK",
      "backgroundColor": "#12121a",
      "overlaysWebView": false
    },
    "Keyboard": {
      "resize": "none"
    }
  }
}
